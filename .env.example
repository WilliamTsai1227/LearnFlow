# LearnFlow 統一環境變數（複製為專案根目錄 .env）
# 使用方式：
#   cp .env.example .env
#   venv：cd app && uvicorn backend.main:app --reload --port 8002
#   Docker：docker compose -f deploy/docker-compose.yml --env-file .env up -d --build

# ── PostgreSQL（docker compose 與本機 psql 共用帳密）──
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow_dev
POSTGRES_DB=learnflow
# 對外 port（5433 避開 Mac 本機 PostgreSQL 5432）
POSTGRES_PORT=5433

# 本機 venv / psql 連線（host → 127.0.0.1:POSTGRES_PORT）
DATABASE_URL=postgresql://learnflow:learnflow_dev@127.0.0.1:5433/learnflow
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# ── Docker Compose ──
NGINX_PORT=80

# ── Auth / JWT ──
SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker（nginx :80）
GOOGLE_OAUTH_REDIRECT_URI=http://localhost/api/user/auth/google/callback
# venv 直連 :8002 時改為：
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8002/api/user/auth/google/callback
FRONTEND_URL=http://localhost
COOKIE_SECURE=false
# 前後端同網域（本機 / nginx 反向代理）用 lax；
# 前後端不同網域（前端 SWA + 後端 Container Apps）必須用 none，且會強制 COOKIE_SECURE=true
COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80
# Chrome 擴充來源（選填，發佈後填 chrome-extension://<id>；本機開發可留空）
EXTENSION_ORIGIN=

# ── 翻譯（Chrome 擴充點字翻譯 / 雙字幕）──
# 使用免費資源，無需金鑰：MyMemory（翻譯）+ Jisho（日文讀音）+ 本地假名轉羅馬拼音。
# 結果會寫入 translation_cache，同一詞只查一次。
# MyMemory 免費額度：匿名 5,000 字元/日；填入有效 email 後提升為 50,000 字元/日。
# 常駐雙字幕會逐句翻譯，建議務必填寫。
MYMEMORY_EMAIL=

# ── EC2 / Docker Hub（deploy/docker-compose.prod.yml 用）──
# DOCKERHUB_USER=
# IMAGE_TAG=latest
