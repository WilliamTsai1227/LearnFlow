# PostgreSQL（與 app / deploy 相同）
DATABASE_URL=postgresql://learnflow:learnflow_dev@127.0.0.1:5433/learnflow

# Google Cloud TTS
# 服務帳號 JSON 金鑰檔的絕對路徑（在 GCP Console 建立並下載）
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-tts-service-account.json

# 語音（Neural2 建議）
GOOGLE_TTS_VOICE_EN=en-US-Neural2-J
GOOGLE_TTS_VOICE_JA=ja-JP-Neural2-B
# 語速：0.25 ~ 4.0，語言學習建議 0.85 ~ 0.95
GOOGLE_TTS_SPEAKING_RATE=0.9

# AWS S3
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-northeast-1
S3_BUCKET=your-bucket-name
# 選填：若 bucket 內還有一層前綴才填，例如 prod/
# DB audio_url 已是 audio/english/... 時通常留空
S3_PREFIX=

# 選填：同時寫一份到本地 frontend（方便 docker 本地測試）
LOCAL_AUDIO_DIR=../app/frontend
