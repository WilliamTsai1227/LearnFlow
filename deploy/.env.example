# PostgreSQL
POSTGRES_USER=learnflow
POSTGRES_PASSWORD=learnflow_dev
POSTGRES_DB=learnflow
POSTGRES_PORT=5433

# FastAPI app（本地開發時寫入 app/.env）
# 使用 5433 避免與 Mac 本機 PostgreSQL（5432）衝突
DATABASE_URL=postgresql://learnflow:learnflow_dev@127.0.0.1:5433/learnflow
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5

# Nginx 對外 port
NGINX_PORT=80
