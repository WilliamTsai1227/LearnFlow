# EC2 正式環境 — 可與根目錄 .env.example 合併使用
# 使用：docker compose -f deploy/docker-compose.prod.yml --env-file .env up -d

POSTGRES_USER=learnflow
POSTGRES_PASSWORD=改成強密碼
POSTGRES_DB=learnflow
POSTGRES_PORT=5432

DOCKERHUB_USER=你的dockerhub帳號
IMAGE_TAG=latest

DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
NGINX_PORT=80

SECRET_KEY=change-me-in-production
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://你的網域/api/user/auth/google/callback
FRONTEND_URL=http://你的網域
COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://你的網域
